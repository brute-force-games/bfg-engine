{
  "name": "@brute-force-games/bfg-engine",
  "version": "0.1.0",
  "description": "Core infrastructure and logic library for Brute Force Games",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "imports": {
    "#example-games/*": "./dist/example-games/*",
    "#v2/*": "./dist/v2/*",
    "@bfg-engine/example-games/*": "./dist/example-games/*",
    "@bfg-engine/v2/*": "./dist/v2/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "npm run test",
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist",
    "routes:generate": "tsr generate",
    "routes:watch": "tsr watch",
    "cli": "node dist/cli/cli.js",
    "web-cli": "VITE_WEB_CLI=true vite --config vite.config.ts"
  },
  "keywords": [
    "game-engine",
    "typescript",
    "brute-force-games"
  ],
  "author": "Brute Force Games",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@bundled-es-modules/memfs": "^4.17.0",
    "@types/node": "^20.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/yargs": "^17.0.35",
    "@vitejs/plugin-react": "^4.2.1",
    "assert": "^2.1.0",
    "path-browserify": "^1.0.1",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "vite": "^5.0.8",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "react": "19.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.50.4-build1",
    "@tanstack/react-form": "^1.23.5",
    "@tanstack/react-router": "^1.132.2",
    "effect": "^3.19.8",
    "qrcode": "^1.5.4",
    "sqlite3": "^5.1.7",
    "tinybase": "^6.7.0",
    "trystero": "^0.22.0",
    "yargs": "^17.7.2",
    "zod": "^4.0.0"
  },
  "bin": {
    "bfg": "./dist/cli/cli.js"
  }
}
